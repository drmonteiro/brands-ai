# ====================================================================
# Confeções Lança - Environment Variables
# Copy this file to .env and fill in your values
# ====================================================================

# ============ 🔴 OBRIGATÓRIOS ============

# --- Azure OpenAI (os "Deployment names" no portal têm de coincidir EXACTAMENTE) ---
AZURE_OPENAI_API_KEY=your-azure-openai-api-key
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=gpt-5.1
AZURE_OPENAI_DEPLOYMENT_FAST=gpt-5-mini
# Opcional: se não definires, o código usa o mesmo nome que AZURE_OPENAI_DEPLOYMENT_FAST
AZURE_OPENAI_EXTRACTION_DEPLOYMENT=gpt-5-mini
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# --- Tavily (Web Search + Extract) ---
TAVILY_API_KEY=tvly-your-tavily-api-key

# ============ 🟡 OPCIONAIS (com defaults) ============

# --- Azure OpenAI (têm defaults) ---
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# --- EUR → USD (preços no frontend legado) ---
EUR_USD_RATE=1.08
GBP_TO_EUR=1.17
USD_TO_EUR=0.93
CHF_TO_EUR=1.05

# --- PostgreSQL (defaults apontam para Docker local) ---
POSTGRES_USER=lanca
POSTGRES_PASSWORD=lanca_password
POSTGRES_DB=lanca_leads
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Para LangGraph checkpointer ---
SYNC_DATABASE_URL=postgresql://lanca:lanca_password@localhost:5432/lanca_leads

# ============ 🟢 OPCIONAIS (para features extra) ============

# --- Resend (envio de emails de parceria) ---
RESEND_API_KEY=re_your-resend-api-key
FROM_EMAIL=onboarding@resend.dev

# --- Jina Reader (fallback para scraping) ---
JINA_API_KEY=jina_your-jina-api-key

# --- Firecrawl (alternativa de scraping, não usado activamente) ---
FIRECRAWL_API_KEY=fc-your-firecrawl-api-key

# --- Crawl4AI (self-hosted; o backend usa CRAWL4AI_BASE_URL) ---
USE_CRAWL4AI=true
CRAWL4AI_BASE_URL=http://localhost:11235

# --- LangSmith (observabilidade/tracing, opcional) ---
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=lsv2_your-langsmith-key
LANGCHAIN_PROJECT=confecos-lanca
