# ====================================================================
# Confeções Lança - Environment Variables
# Copy this file to .env and fill in your values
# Pipeline tuning: see docs/PIPELINE_CONFIG.md
# ====================================================================

# ============ 🔴 OBRIGATÓRIOS ============

# --- Azure OpenAI (deployment names must match the Azure portal exactly) ---
AZURE_OPENAI_API_KEY=your-azure-openai-api-key
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=gpt-5.1
AZURE_OPENAI_DEPLOYMENT_FAST=gpt-5-mini
# Optional: defaults to AZURE_OPENAI_DEPLOYMENT_FAST if unset
AZURE_OPENAI_EXTRACTION_DEPLOYMENT=gpt-5-mini
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# --- Exa (discovery N1 + supplemental enrich) ---
EXA_API_KEY=your-exa-api-key

# ============ 🟡 OPCIONAIS (com defaults) ============

AZURE_OPENAI_API_VERSION=2024-12-01-preview

# --- FX (prompts / legacy UI) ---
EUR_USD_RATE=1.08
GBP_TO_EUR=1.17
USD_TO_EUR=0.93
CHF_TO_EUR=1.05

# --- Pipeline parallelism (see docs/PIPELINE_CONFIG.md) ---
EXA_QUERY_MAX_CONCURRENT=6
EXA_NUM_RESULTS=20
ENRICH_LLM_BATCH_CONCURRENT=0
FIT_LLM_BATCH_CONCURRENT=0

# --- LLM per task (true=mini, false=gpt-5.1). Fit defaults to 5.1.
# LLM_STRUCTURED_EXTRACT_FAST=true
# LLM_HQ_BATCH_FAST=true
# LLM_STORE_EXTRACT_FAST=true
# LLM_FIT_ASSESSMENT_FAST=false

# --- Cross-city brand facts cache ---
BRAND_FACTS_TTL_DAYS=30

# --- PostgreSQL (Docker local defaults) ---
POSTGRES_USER=lanca
POSTGRES_PASSWORD=lanca_password
POSTGRES_DB=lanca_leads
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
SYNC_DATABASE_URL=postgresql://lanca:lanca_password@localhost:5432/lanca_leads

# ============ 🟢 OPCIONAIS (features extra) ============

RESEND_API_KEY=re_your-resend-api-key
FROM_EMAIL=onboarding@resend.dev

JINA_API_KEY=jina_your-jina-api-key

GOOGLE_PLACES_API_KEY=your-google-places-api-key

LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=lsv2_your-langsmith-key
LANGCHAIN_PROJECT=confecos-lanca
